[Unit]
Description=Omoide isolated AdaFace ROCm inference
Documentation=https://github.com/kriegcloud/Omoide
After=local-fs.target
ConditionPathExists=/dev/kfd
ConditionPathExists=/dev/dri/renderD128

[Service]
Type=simple
WorkingDirectory=/home/elpresidank/YeeBois/workstation-apps/Omoide/vendor/photo-face
Environment=PYTHONPATH=/home/elpresidank/YeeBois/workstation-apps/Omoide/vendor/photo-face
Environment=HIP_VISIBLE_DEVICES=0
# --det-size N optionally sets SCRFD's square CPU input (default 640;
# multiples of 32, 320..1600). Use separate sockets for resolution experiments.
Environment=LD_LIBRARY_PATH=/home/elpresidank/.cache/beep/photo-face/rocm-libs/hipsparselt-7.2.4-1.1/opt/rocm/lib:/opt/rocm/lib
ExecStart=/home/elpresidank/.cache/omoide/photo-face/venv-rocm72/bin/python -m beep_photo_face.service --socket /home/elpresidank/.local/share/omoide-portal/run/omoide-ml.sock --model-root /home/elpresidank/.local/share/omoide-portal/models/adaface-kprpe --detector /home/elpresidank/.local/share/omoide-portal/models/adaface-kprpe/detector/det_10g.onnx --aligner /home/elpresidank/.local/share/omoide-portal/models/adaface-kprpe/aligner/model.safetensors --recognizer /home/elpresidank/.local/share/omoide-portal/models/adaface-kprpe/recognizer/model.safetensors --device 0 --batch-size 16
Restart=on-failure
RestartSec=5s
Nice=5
CPUWeight=50
MemoryHigh=12G
MemoryMax=16G
OOMPolicy=stop
TimeoutStartSec=5min
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/elpresidank/.local/share/omoide-portal/run
# MIOpen (ROCm) writes kernel caches and lock files under these two directories.
# Without them ProtectHome=read-only makes every inference fail with
# "MIOpen Error: Read-only file system" (found 2026-09-10).
ReadWritePaths=/home/elpresidank/.config/miopen /home/elpresidank/.cache/miopen
InaccessiblePaths=-/run/media/elpresidank/T7
InaccessiblePaths=-/run/media/elpresidank/T7XFER
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
