[Unit]
Description=Omoide SigLIP 2 and TOPIQ-NR ROCm inference
Documentation=https://github.com/kriegcloud/Omoide
After=local-fs.target
ConditionPathExists=/dev/kfd
ConditionPathExists=/dev/dri/renderD128

[Service]
Type=simple
WorkingDirectory=/home/elpresidank/YeeBois/workstation-apps/Omoide/vendor/omoide-vision
Environment=PYTHONPATH=/home/elpresidank/YeeBois/workstation-apps/Omoide/vendor/omoide-vision
Environment=HIP_VISIBLE_DEVICES=1
Environment=MIOPEN_FIND_MODE=FAST
Environment=HF_HUB_OFFLINE=1
Environment=LD_LIBRARY_PATH=/home/elpresidank/.local/share/omoide-portal/rocm-libs/hipsparselt-7.2.4-1.1/opt/rocm/lib:/opt/rocm/lib
Environment=HF_HOME=/home/elpresidank/.cache/omoide/vision/hf
Environment=TORCH_HOME=/home/elpresidank/.cache/omoide/vision/torch
ExecStart=/home/elpresidank/.cache/omoide/vision/venv-rocm72/bin/python -m omoide_vision.service --socket /home/elpresidank/.local/share/omoide-portal/run/omoide-vision.sock --device 0 --batch-size 16
Restart=on-failure
RestartSec=5s
Nice=5
CPUWeight=50
MemoryHigh=12G
MemoryMax=16G
OOMPolicy=stop
TimeoutStartSec=5min
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/elpresidank/.local/share/omoide-portal/run
# MIOpen (ROCm) writes kernel caches and lock files under these two directories.
# Without them ProtectHome=read-only makes every inference fail with
# "MIOpen Error: Read-only file system" (found 2026-09-10).
ReadWritePaths=/home/elpresidank/.cache/omoide/vision/hf /home/elpresidank/.cache/omoide/vision/torch
ReadWritePaths=/home/elpresidank/.config/miopen /home/elpresidank/.cache/miopen
InaccessiblePaths=-/run/media/elpresidank/T7
InaccessiblePaths=-/run/media/elpresidank/T7XFER
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
