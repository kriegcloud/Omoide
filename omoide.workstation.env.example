# Minimal identity-first settings for docker-compose.workstation.yml.

# Keep processing APIs available. The workstation profile deliberately mounts
# media read-write, while every automatic cleanup/deletion path stays disabled.
OMOIDE_GENERAL__PRESENTATION_MODE=false
OMOIDE_GENERAL__ENABLE_PEOPLE=true

# Make every expensive or destructive background action operator-initiated.
OMOIDE_SCAN__AUTO_SCAN=false
OMOIDE_SCAN__AUTO_CLEAN_ON_SCAN=false
OMOIDE_SCAN__AUTO_CLEANUP_WITHOUT_REVIEW=false
OMOIDE_SCAN__AUTO_CLUSTER_ON_SCAN=false
OMOIDE_SCAN__IMAGE_SUFFIXES=.jpg,.jpeg,.png,.tiff,.bmp,.heic,.heif,.webp

# Inventory duplicate groups without changing either copy.
OMOIDE_DUPLICATES__DUPLICATE_AUTO_HANDLING=keep

# The pinned upstream image is the CPU build. Keep face processing active while
# skipping the separate semantic-search and automatic-tagging workloads.
OMOIDE_PROCESSORS__PREFER_GPU=false
OMOIDE_PROCESSORS__IMAGE_EMBEDDING_PROCESSOR_ACTIVE=false
OMOIDE_TAGGING__AUTO_TAGGING=false

# The high-quality recognizer runs on one host GPU behind a private Unix socket.
# Do not switch this on until the existing face vectors have been migrated.
OMOIDE_FACE_RECOGNITION__EMBEDDING_BACKEND=buffalo_l
OMOIDE_FACE_RECOGNITION__INFERENCE_SOCKET_PATH=/app/data/run/omoide-ml.sock

# The optional dataset-annotation UI talks only to the allowlisted host bridge.
# The workstation Compose profile enables this and mounts the shared data root.
OMOIDE_ANNOTATIONS__ENABLED=true
OMOIDE_ANNOTATIONS__INFERENCE_SOCKET_PATH=/app/data/run/omoide-comfy.sock
# Must remain above the bridge's 900s profile deadline plus reconciliation margin.
OMOIDE_ANNOTATIONS__INFERENCE_TIMEOUT_SECONDS=1080
